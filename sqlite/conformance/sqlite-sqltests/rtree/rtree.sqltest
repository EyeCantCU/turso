@database :memory:
@skip-file-if mvcc "virtual tables are not supported in MVCC mode"

test rtree-basic {
    CREATE VIRTUAL TABLE rt USING rtree(id, x0, x1, y0, y1);
    INSERT INTO rt VALUES(1, 0, 10, 0, 10), (2, 5, 15, 5, 15), (3, 20, 30, 20, 30);
    SELECT * FROM rt;
    SELECT id FROM rt WHERE x0 >= 5;
    SELECT id FROM rt WHERE x1 < 12 AND y1 <= 10;
    SELECT id FROM rt WHERE id = 2;
    SELECT count(*) FROM rt WHERE x0 > 100;
}
expect {
    1|0.0|10.0|0.0|10.0
    2|5.0|15.0|5.0|15.0
    3|20.0|30.0|20.0|30.0
    2
    3
    1
    2
    0
}

test rtree-shadow-tables {
    CREATE VIRTUAL TABLE rt USING rtree(id, x0, x1, +a, +b);
    SELECT name, type, rootpage > 0 FROM sqlite_schema WHERE name LIKE 'rt%' ORDER BY name;
    SELECT nodeno, length(data), rtreedepth(data) FROM rt_node;
    INSERT INTO rt VALUES(7, 1.5, 2.5, 'x', 4);
    SELECT * FROM rt_rowid;
    SELECT nodeno, hex(data) FROM rt_node;
}
expect {
    rt|table|0
    rt_node|table|1
    rt_parent|table|1
    rt_rowid|table|1
    1|820|0
    7|1|x|4
    1|
}

test rtree-node-format {
    CREATE VIRTUAL TABLE r2 USING rtree(id, a, b, c, d);
    INSERT INTO r2 VALUES(1, 0.5, 1.5, -2, 2), (2, 100, 200, 3, 4);
    SELECT hex(substr(data, 1, 52)) FROM r2_node WHERE nodeno = 1;
    SELECT rtreenode(2, data) FROM r2_node;
}
expect {
    0000000200000000000000013F0000003FC00000C000000040000000000000000000000242C80000434800004040000040800000
    {1 0.5 1.5 -2 2} {2 100 200 3 4}
}

test rtree-i32 {
    CREATE VIRTUAL TABLE ri USING rtree_i32(id, a, b);
    INSERT INTO ri VALUES(1, 1.7, 5000000000);
    INSERT INTO ri VALUES(2, -5000000000, '12');
    INSERT INTO ri VALUES(3, -2.9, -1.2);
    SELECT * FROM ri;
    SELECT typeof(a), typeof(b) FROM ri WHERE id = 1;
}
expect {
    1|1|2147483647
    2|-2147483648|12
    3|-2|-1
    integer|integer
}

test rtree-float32-rounding {
    CREATE VIRTUAL TABLE rf USING rtree(id, a, b);
    INSERT INTO rf VALUES(1, 0.1, 0.1);
    SELECT a < 0.1, b > 0.1, a = b FROM rf;
    SELECT id FROM rf WHERE a <= 0.1 AND b >= 0.1;
    INSERT INTO rf VALUES(2, 16777217, 16777217);
    SELECT a, b FROM rf WHERE id = 2;
}
expect {
    1|1|0
    1
    16777216.0|16777218.0
}

test rtree-aux-columns {
    CREATE VIRTUAL TABLE ra USING rtree(id, a, b, +name, +payload);
    INSERT INTO ra VALUES(1, 0, 1, 'one', x'01ff');
    INSERT INTO ra VALUES(2, 2, 3, NULL, 2.5);
    UPDATE ra SET name = 'two' WHERE id = 2;
    SELECT id, a, b, name, hex(payload) FROM ra;
    SELECT id FROM ra WHERE name = 'two';
    SELECT rowid, nodeno, a0, hex(a1) FROM ra_rowid;
}
expect {
    1|0.0|1.0|one|01FF
    2|2.0|3.0|two|322E35
    2
    1|1|one|01FF
    2|1|two|322E35
}

test rtree-null-id-and-rowid {
    CREATE VIRTUAL TABLE rt USING rtree(id, a, b);
    INSERT INTO rt VALUES(NULL, 0, 1);
    INSERT INTO rt(a, b) VALUES(2, 3);
    INSERT INTO rt VALUES(10, 0, 1);
    INSERT INTO rt VALUES(NULL, 4, 5);
    SELECT id, rowid FROM rt;
    SELECT last_insert_rowid();
    SELECT id FROM rt WHERE rowid = 2;
    SELECT id FROM rt WHERE id = 10.0;
    SELECT id FROM rt WHERE id = '10';
    SELECT id FROM rt WHERE id = 10.5;
}
expect {
    1|1
    2|2
    10|10
    11|11
    11
    2
    10
    10
}

test rtree-bound-constraint-error {
    CREATE VIRTUAL TABLE rt USING rtree(id, x0, x1);
    INSERT INTO rt VALUES(1, 5, 4);
}
expect error {
    rtree constraint failed: rt\.\(x0<=x1\)
}

test rtree-unique-constraint-error {
    CREATE VIRTUAL TABLE rt USING rtree(id, x0, x1);
    INSERT INTO rt VALUES(1, 0, 1);
    INSERT INTO rt VALUES(1, 2, 3);
}
expect error {
    UNIQUE constraint failed: rt\.id
}

test rtree-or-replace-or-ignore {
    CREATE VIRTUAL TABLE rt USING rtree(id, x0, x1);
    INSERT INTO rt VALUES(1, 0, 1), (2, 2, 3);
    INSERT OR REPLACE INTO rt VALUES(1, 10, 11);
    INSERT OR IGNORE INTO rt VALUES(2, 20, 21);
    INSERT OR IGNORE INTO rt VALUES(3, 9, 8);
    SELECT * FROM rt;
    SELECT changes();
    UPDATE OR REPLACE rt SET id = 2 WHERE id = 1;
    SELECT * FROM rt;
}
expect {
    2|2.0|3.0
    1|10.0|11.0
    0
    2|10.0|11.0
}

test rtree-bad-columns-10 {
    CREATE VIRTUAL TABLE bad USING rtree(a, b);
}
expect error {
    Too few columns for an rtree table
}

test rtree-bad-columns-11 {
    CREATE VIRTUAL TABLE bad USING rtree(a, b, c, d);
}
expect error {
    Wrong number of columns for an rtree table
}

test rtree-bad-columns-12 {
    CREATE VIRTUAL TABLE bad USING rtree(a, b, c, +d, e);
}
expect error {
    Auxiliary rtree columns must be last
}

test rtree-bad-columns-13 {
    CREATE VIRTUAL TABLE bad USING rtree(a, b, c, d, e, f, g, h, i, j, k, l, m);
}
expect error {
    Too many columns for an rtree table
}

test rtree-many-rows {
    CREATE VIRTUAL TABLE rt USING rtree(id, x0, x1, y0, y1);
    WITH RECURSIVE c(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM c WHERE i < 1000)
    INSERT INTO rt SELECT i, i % 37, i % 37 + i % 5, i % 101, i % 101 + 1 FROM c;
    SELECT count(*), sum(id) FROM rt;
    SELECT count(*) FROM rt WHERE x0 >= 10 AND x1 <= 20 AND y0 < 50;
    SELECT rtreedepth(data) FROM rt_node WHERE nodeno = 1;
    SELECT count(*) FROM rt_node;
    SELECT count(*) FROM rt_parent;
    SELECT rtreecheck('rt');
    SELECT hex(data) = (SELECT hex(data) FROM rt_node WHERE nodeno = 1) FROM rt_node WHERE nodeno = 1;
    DELETE FROM rt WHERE id % 3 = 0;
    SELECT count(*) FROM rt;
    UPDATE rt SET x0 = x0 + 100, x1 = x1 + 100 WHERE id % 2 = 0;
    SELECT count(*) FROM rt WHERE x0 >= 100;
    SELECT (SELECT count(*) FROM rt_node), (SELECT count(*) FROM rt_parent);
    SELECT rtreecheck('main', 'rt');
    DELETE FROM rt;
    SELECT count(*) FROM rt_node;
    SELECT rtreedepth(data) FROM rt_node;
}
expect {
    1000|500500
    116
    1
    29
    28
    ok
    1
    667
    334
    21|20
    ok
    1
    0
}

test rtree-node-identical-after-splits {
    CREATE VIRTUAL TABLE rt USING rtree(id, x0, x1);
    WITH RECURSIVE c(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM c WHERE i < 300)
    INSERT INTO rt SELECT i, (i * 7919) % 1000, (i * 7919) % 1000 + i % 13 FROM c;
    DELETE FROM rt WHERE id % 4 = 1;
    SELECT nodeno, hex(data) FROM rt_node ORDER BY nodeno LIMIT 3;
    SELECT * FROM rt_parent ORDER BY nodeno;
}
expect {
    1|
    2|
    3|
    2|1
    3|1
    4|1
    5|1
    6|1
    7|1
    8|1
    9|1
}

test rtree-insert-select-from-self {
    CREATE VIRTUAL TABLE rt USING rtree(id, x0, x1);
    INSERT INTO rt VALUES(1, 0, 1), (2, 2, 3);
    INSERT INTO rt SELECT id + 10, x0 + 10, x1 + 10 FROM rt;
    SELECT * FROM rt;
}
expect {
    1|0.0|1.0
    2|2.0|3.0
    11|10.0|11.0
    12|12.0|13.0
}

test rtree-triggers {
    CREATE TABLE t(fid INTEGER PRIMARY KEY, x REAL, y REAL);
    CREATE VIRTUAL TABLE rt USING rtree(id, minx, maxx, miny, maxy);
    CREATE TRIGGER t_ins AFTER INSERT ON t BEGIN INSERT OR REPLACE INTO rt VALUES (NEW.fid, NEW.x, NEW.x, NEW.y, NEW.y); END;
    CREATE TRIGGER t_upd AFTER UPDATE OF x ON t BEGIN UPDATE rt SET minx = NEW.x, maxx = NEW.x WHERE id = NEW.fid; END;
    CREATE TRIGGER t_del AFTER DELETE ON t BEGIN DELETE FROM rt WHERE id = OLD.fid; END;
    INSERT INTO t VALUES(1, 1, 2), (2, 3, 4), (3, 5, 6);
    UPDATE t SET x = 30 WHERE fid = 2;
    DELETE FROM t WHERE fid = 1;
    SELECT * FROM rt;
}
expect {
    3|5.0|5.0|6.0|6.0
    2|30.0|30.0|4.0|4.0
}

test rtree-drop-and-rename {
    CREATE VIRTUAL TABLE rt USING rtree(id, x0, x1);
    INSERT INTO rt VALUES(1, 0, 1);
    ALTER TABLE rt RENAME TO moved;
    SELECT name FROM sqlite_schema ORDER BY name;
    SELECT * FROM moved;
    INSERT INTO moved VALUES(2, 5, 6);
    SELECT id FROM moved WHERE x0 > 1;
    DROP TABLE moved;
    SELECT count(*) FROM sqlite_schema;
}
expect {
    moved
    moved_node
    moved_parent
    moved_rowid
    1|0.0|1.0
    2
    0
}

test rtree-default-values-and-integrity {
    CREATE VIRTUAL TABLE rt USING rtree(id, x0, x1);
    INSERT INTO rt DEFAULT VALUES;
    INSERT INTO rt DEFAULT VALUES;
    SELECT * FROM rt;
    PRAGMA integrity_check;
}
expect {
    1|0.0|0.0
    2|0.0|0.0
    ok
}

test rtree-functions {
    SELECT rtreedepth(x'00030000');
    SELECT rtreenode(1, x'0000000100000000000000053F80000040000000');
    SELECT rtreenode(0, x'00'), rtreenode(1, x'00');
}
expect {
    3
    {5 1 2}
    |
}

test rtreedepth-bad-argument {
    SELECT rtreedepth(1);
}
expect error {
    Invalid argument to rtreedepth\(\)
}

test rtreecheck-wrong-args {
    SELECT rtreecheck();
}
expect error {
    wrong number of arguments to function rtreecheck\(\)
}

test rtree-match-unknown {
    CREATE VIRTUAL TABLE rt USING rtree(id, x0, x1);
    INSERT INTO rt VALUES(1, 0, 1);
    SELECT id FROM rt WHERE id MATCH x'00';
}
expect error {
    SQL logic error
}
