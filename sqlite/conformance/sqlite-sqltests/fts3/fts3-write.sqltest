@database :memory:

# FTS3/FTS4 writes: shadow tables are compared byte for byte with SQLite's.
# Expected output is SQLite 3.54's.

test fts3-write-shadow-tables {
    CREATE VIRTUAL TABLE t USING fts4(a, b);
    INSERT INTO t VALUES('hello world', 'the quick brown fox');
    INSERT INTO t(docid, a, b) VALUES(10, 'hello again', 'lazy dog');
    UPDATE t SET a = 'goodbye world' WHERE docid = 1;
    DELETE FROM t WHERE docid = 10;
    SELECT level, idx, start_block, leaves_end_block, end_block, hex(root) FROM t_segdir;
    SELECT docid, hex(size) FROM t_docsize;
    SELECT id, hex(value) FROM t_stat;
    SELECT * FROM t_content;
}
expect {
    0|0|0|0|0 70|000562726F776E0501010104000003666F78050101010500000568656C6C6F030102000005717569636B05010101030000037468650501010102000005776F726C6403010300
    0|1|0|0|0 45|0005616761696E030A03000003646F67050A01010300000568656C6C6F030A020000046C617A79050A01010200
    0|2|0|0|0 82|000562726F776E0501010104000003666F780501010105000007676F6F6462796503010200000568656C6C6F0201000005717569636B05010101030000037468650501010102000005776F726C6403010300
    0|3|0|0|0 37|0005616761696E020A000003646F67020A00000568656C6C6F020A0000046C617A79020A00
    1|0204
    0|01020420
    1|goodbye world|the quick brown fox
}

test fts3-write-transaction-pending {
    CREATE VIRTUAL TABLE t USING fts3(x);
    BEGIN;
    INSERT INTO t VALUES('one two');
    INSERT INTO t VALUES('two three');
    SELECT count(*) FROM t_segdir;
    SELECT rowid FROM t WHERE t MATCH 'two';
    COMMIT;
    SELECT level, idx, hex(root) FROM t_segdir;
}
expect {
    0
    1
    2
    0|0|00036F6E650301020000057468726565030203000102776F06010300010200
}

test fts3-write-rollback-drops-pending {
    CREATE VIRTUAL TABLE t USING fts3(x);
    INSERT INTO t VALUES('kept');
    BEGIN;
    INSERT INTO t VALUES('dropped kept');
    ROLLBACK;
    SELECT rowid, x FROM t WHERE t MATCH 'kept';
    INSERT INTO t(t) VALUES('integrity-check');
}
expect {
    1|kept
}

test fts3-write-out-of-order-docids {
    CREATE VIRTUAL TABLE t USING fts4(x);
    BEGIN;
    INSERT INTO t(docid, x) VALUES(50, 'alpha');
    INSERT INTO t(docid, x) VALUES(20, 'alpha beta');
    INSERT INTO t(docid, x) VALUES(70, 'beta');
    COMMIT;
    SELECT level, idx, hex(root) FROM t_segdir;
    SELECT docid FROM t WHERE t MATCH 'alpha';
}
expect {
    0|0|0005616C70686103320200
    0|1|0005616C7068610314020000046265746106140300320200
    20
    50
}

test fts3-write-level-merge {
    CREATE VIRTUAL TABLE t USING fts3(x);
    WITH RECURSIVE n(i) AS (SELECT 1 UNION ALL SELECT i+1 FROM n WHERE i < 20)
    SELECT count(*) FROM n;
    INSERT INTO t VALUES('w1 common');INSERT INTO t VALUES('w2 common');INSERT INTO t VALUES('w3 common');
    INSERT INTO t VALUES('w4 common');INSERT INTO t VALUES('w5 common');INSERT INTO t VALUES('w6 common');
    INSERT INTO t VALUES('w7 common');INSERT INTO t VALUES('w8 common');INSERT INTO t VALUES('w9 common');
    INSERT INTO t VALUES('w10 common');INSERT INTO t VALUES('w11 common');INSERT INTO t VALUES('w12 common');
    INSERT INTO t VALUES('w13 common');INSERT INTO t VALUES('w14 common');INSERT INTO t VALUES('w15 common');
    INSERT INTO t VALUES('w16 common');INSERT INTO t VALUES('w17 common');
    SELECT level, count(*) FROM t_segdir GROUP BY level;
    SELECT hex(root) FROM t_segdir WHERE level = 1;
}
expect {
    20
    0|1
    1|1
    
}

test fts3-write-insert-select {
    CREATE TABLE docs(id INTEGER PRIMARY KEY, body);
    INSERT INTO docs VALUES(1, 'red fish'), (2, 'blue fish'), (7, 'one fish');
    CREATE VIRTUAL TABLE t USING fts4(body);
    INSERT INTO t(docid, body) SELECT id, body FROM docs;
    SELECT docid FROM t WHERE t MATCH 'fish';
    SELECT level, idx, hex(root) FROM t_segdir;
}
expect {
    1
    2
    7
    0|0|0004626C7565030202000004666973680901030001030005030000036F6E6503070200000372656403010200
}

test fts3-write-special-optimize {
    CREATE VIRTUAL TABLE t USING fts4(x);
    INSERT INTO t VALUES('a b');
    INSERT INTO t VALUES('b c');
    INSERT INTO t VALUES('c d');
    INSERT INTO t(t) VALUES('optimize');
    SELECT level, idx, hex(root) FROM t_segdir;
    SELECT optimize(t) FROM t LIMIT 1;
}
expect {
    0|0|00016103010200000162060103000102000001630602030001020000016403030300
    Index already optimal
}

test fts3-write-special-rebuild {
    CREATE TABLE src(x);
    INSERT INTO src VALUES('alpha beta'), ('beta gamma');
    CREATE VIRTUAL TABLE t USING fts4(content=src, x);
    INSERT INTO t(t) VALUES('rebuild');
    SELECT docid FROM t WHERE t MATCH 'beta';
    SELECT id, hex(value) FROM t_stat;
    INSERT INTO t(t) VALUES('integrity-check');
}
expect {
    1
    2
    0|020414
}

test fts3-write-special-merge {
    CREATE VIRTUAL TABLE t USING fts4(x);
    INSERT INTO t VALUES('a');INSERT INTO t VALUES('b');INSERT INTO t VALUES('c');INSERT INTO t VALUES('d');
    INSERT INTO t(t) VALUES('merge=10,2');
    SELECT level, idx, start_block, leaves_end_block, end_block, hex(root) FROM t_segdir;
    SELECT id, hex(value) FROM t_stat;
    INSERT INTO t(t) VALUES('integrity-check');
}
expect {
    1|0|1|1|128 28|0101
    0|040404
}

test fts3-write-special-automerge {
    CREATE VIRTUAL TABLE t USING fts4(x);
    INSERT INTO t(t) VALUES('automerge=4');
    SELECT id, value FROM t_stat WHERE id = 2;
}
expect {
    2|4
}

test fts3-write-special-unknown {
    CREATE VIRTUAL TABLE t USING fts4(x);
    INSERT INTO t(t) VALUES('nonsense');
}
expect error {
    SQL logic error
}

test fts3-write-duplicate-docid {
    CREATE VIRTUAL TABLE t USING fts4(x);
    INSERT INTO t(docid, x) VALUES(1, 'a');
    INSERT INTO t(docid, x) VALUES(1, 'b');
}
expect error {
    constraint failed
}

test fts3-write-drop-and-rename {
    CREATE VIRTUAL TABLE t USING fts4(x);
    INSERT INTO t VALUES('alpha');
    ALTER TABLE t RENAME TO u;
    SELECT name FROM sqlite_schema WHERE name LIKE 'u%' ORDER BY name;
    SELECT rowid FROM u WHERE u MATCH 'alpha';
    DROP TABLE u;
    SELECT count(*) FROM sqlite_schema;
}
expect {
    u
    u_content
    u_docsize
    u_segdir
    u_segments
    u_stat
    1
    0
}
