@database database/fts3_sqlite.db readonly

# FTS3/FTS4 tables written by SQLite 3.54 (see the generator in the
# fts3 report): multi-level segments, interior nodes, an incremental
# merge, prefix indexes, order=DESC, languageid, content= and options.
# Expected output is SQLite's.

test fts3-read-match-term {
    SELECT docid FROM t3 WHERE t3 MATCH 'zeta' ORDER BY docid LIMIT 12;
}
expect {
    6
    9
    10
    14
    16
    23
    27
    28
    33
    37
    39
    43
}

test fts3-read-match-count {
    SELECT count(*) FROM t3 WHERE t3 MATCH 'alpha';
    SELECT count(*) FROM t4 WHERE t4 MATCH 'alpha';
    SELECT count(*) FROM td WHERE td MATCH 'alpha';
}
expect {
    138
    138
    109
}

test fts3-read-and-or-not {
    SELECT docid FROM t3 WHERE t3 MATCH 'alpha beta -gamma' LIMIT 5;
    SELECT docid FROM t3 WHERE t3 MATCH '(alpha OR beta) NOT gamma' LIMIT 5;
}
expect {
    14
    37
    51
    77
    85
    3
    7
    9
    20
    24
}

test fts3-read-malformed-and-not {
    SELECT count(*) FROM t3 WHERE t3 MATCH 'alpha AND beta AND NOT gamma';
}
expect error {
    malformed MATCH expression: \[alpha AND beta AND NOT gamma\]
}

test fts3-read-phrase-near {
    SELECT docid, offsets(t3) FROM t3 WHERE t3 MATCH '"alpha beta"' LIMIT 4;
    SELECT docid, offsets(t3) FROM t3 WHERE t3 MATCH 'alpha NEAR/2 zeta' LIMIT 4;
    SELECT docid FROM t3 WHERE t3 MATCH 'one NEAR/1 two NEAR/1 three';
}
expect {
    124|1 0 52 5 1 1 58 4
    171|1 0 6 5 1 1 12 4
    180|1 0 10 5 1 1 16 4
    195|1 0 19 5 1 1 25 4
    16|1 1 94 4 1 0 109 5
    27|1 1 102 4 1 0 113 5
    45|1 1 50 4 1 0 55 5
    58|1 0 67 5 1 1 73 4 1 0 78 5
    128
    235
    390
}

test fts3-read-column-filter {
    SELECT docid FROM t3 WHERE t3 MATCH 'title:kappa body:lambda' LIMIT 5;
    SELECT docid FROM t3 WHERE title MATCH 'kappa' LIMIT 5;
}
expect {
    26
    105
    118
    233
    250
    9
    12
    26
    87
    101
}

test fts3-read-prefix {
    SELECT count(*) FROM t3 WHERE t3 MATCH 'app*';
    SELECT count(*) FROM t4 WHERE t4 MATCH 'ap*';
    SELECT count(*) FROM t4 WHERE t4 MATCH 'appl*';
    SELECT count(*) FROM t4 WHERE t4 MATCH 'con*';
}
expect {
    284
    284
    284
    260
}

test fts4-read-porter {
    SELECT count(*) FROM t4 WHERE t4 MATCH 'connections';
    SELECT count(*) FROM t4 WHERE t4 MATCH 'run';
}
expect {
    260
    230
}

test fts4-read-first-token {
    SELECT docid FROM t4 WHERE t4 MATCH '^alpha' LIMIT 6;
}
expect {
    9
    24
    45
    85
    87
    110
}

test fts4-read-order-desc {
    SELECT docid FROM td WHERE td MATCH 'kappa' LIMIT 5;
    SELECT docid FROM td WHERE td MATCH 'kappa' ORDER BY docid LIMIT 5;
}
expect {
    393
    391
    389
    387
    385
    3
    5
    8
    9
    16
}

test fts4-read-languageid {
    SELECT docid FROM tl WHERE tl MATCH 'mu' AND lid = 2 LIMIT 5;
    SELECT count(*) FROM tl WHERE tl MATCH 'mu';
}
expect {
    5
    20
    32
    50
    62
    49
}

test fts4-read-content-table {
    SELECT docid, title FROM tc WHERE tc MATCH 'iota iota' LIMIT 3;
}
expect {
    8|lambda cafe mu
    10|running running
    12|iota kappa
}

test fts4-read-unicode61 {
    SELECT count(*) FROM tu WHERE tu MATCH 'resume';
    SELECT count(*) FROM tu WHERE tu MATCH 'cafe';
    SELECT count(*) FROM tu WHERE tu MATCH '"x-ray"';
}
expect {
    125
    195
    129
}

test fts4-read-notindexed {
    SELECT count(*) FROM tn WHERE tn MATCH 'alpha';
    SELECT count(*) FROM tn WHERE b MATCH 'alpha';
}
expect {
    42
    0
}

test fts3-read-snippet {
    SELECT snippet(t3) FROM t3 WHERE t3 MATCH 'gamma delta' LIMIT 3;
    SELECT snippet(t3, '[', ']', '..', 1, 5) FROM t3 WHERE t3 MATCH 'gamma' LIMIT 3;
    SELECT snippet(t4, '{', '}', '~', -1, -3) FROM t4 WHERE t4 MATCH 'zeta OR iota' LIMIT 3;
}
expect {
    <b>gamma</b> x-ray connects <b>delta</b>
    <b>...</b>beta <b>gamma</b> runs runs <b>gamma</b> theta <b>gamma</b> connects runs beta x-ray apple <b>delta</b> three<b>...</b>
    mu <b>delta</b> connects cafe <b>gamma</b> apple beta apply eta
    [gamma] x-ray connects delta
    ..beta [gamma] runs runs [gamma]..
    ..connects cafe [gamma] apple beta..
    ~runs {zeta} naïve~
    ~three {iota} connection~
    ~mu {zeta} apply~
}

test fts3-read-matchinfo {
    SELECT hex(matchinfo(t3)) FROM t3 WHERE t3 MATCH 'alpha beta' LIMIT 2;
    SELECT hex(matchinfo(t4, 'pcnalxsyb')) FROM t4 WHERE t4 MATCH 'alpha' LIMIT 2;
}
expect {
    0200000002000000000000002B0000002900000001000000830000006A000000000000001E0000001E00000001000000A40000007D000000
    0200000002000000000000002B0000002900000001000000830000006A000000000000001E0000001E00000002000000A40000007D000000
    010000000200000071010000030000000C000000040000000E000000000000002B0000002900000001000000830000006A0000000000000001000000000000000100000002000000
    010000000200000071010000030000000C0000000400000009000000000000002B0000002900000001000000830000006A0000000000000001000000000000000100000002000000
}

test fts3-read-docid-lookup {
    SELECT docid, title FROM t3 WHERE docid = 17;
    SELECT docid FROM t3 WHERE docid BETWEEN 100 AND 104;
}
expect {
    17|epsilon cafe connects
    100
    101
    102
    103
    104
}
