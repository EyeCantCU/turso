@database :memory:
@skip-file-if mvcc "virtual tables are not supported in MVCC mode"

test geopoly-functions {
    SELECT geopoly_json('[[0,0],[1,0],[1,1],[0,1],[0,0]]');
    SELECT geopoly_area('[[0,0],[2,0],[2,2],[0,2],[0,0]]'), geopoly_area('[[0,0],[0,2],[2,2],[2,0],[0,0]]');
    SELECT hex(geopoly_blob('[[0,0],[1,0],[1,1],[0,0]]'));
    SELECT geopoly_json(geopoly_ccw('[[0,0],[0,2],[2,2],[2,0],[0,0]]'));
    SELECT geopoly_json(geopoly_bbox('[[1,1],[3,0],[4,5],[0,2],[1,1]]'));
    SELECT geopoly_svg('[[0,0],[1,0],[1,1],[0,0]]', 'fill="red"', '');
    SELECT geopoly_json(geopoly_xform('[[0,0],[1,0],[1,1],[0,0]]', 2, 0, 0, 2, 1, 1));
    SELECT geopoly_contains_point('[[0,0],[4,0],[4,4],[0,4],[0,0]]', 2, 2), geopoly_contains_point('[[0,0],[4,0],[4,4],[0,4],[0,0]]', 4, 2), geopoly_contains_point('[[0,0],[4,0],[4,4],[0,4],[0,0]]', 5, 2);
    SELECT geopoly_overlap('[[0,0],[4,0],[4,4],[0,4],[0,0]]', '[[1,1],[2,1],[2,2],[1,2],[1,1]]'), geopoly_overlap('[[1,1],[2,1],[2,2],[1,2],[1,1]]', '[[0,0],[4,0],[4,4],[0,4],[0,0]]'), geopoly_overlap('[[0,0],[1,0],[1,1],[0,1],[0,0]]', '[[5,5],[6,5],[6,6],[5,6],[5,5]]'), geopoly_overlap('[[0,0],[2,0],[2,2],[0,2],[0,0]]', '[[1,1],[3,1],[3,3],[1,3],[1,1]]');
    SELECT geopoly_within('[[1,1],[2,1],[2,2],[1,2],[1,1]]', '[[0,0],[4,0],[4,4],[0,4],[0,0]]'), geopoly_within('[[0,0],[4,0],[4,4],[0,4],[0,0]]', '[[0,0],[4,0],[4,4],[0,4],[0,0]]');
    SELECT geopoly_json(geopoly_regular(0, 0, 1, 4)) IS NOT NULL, geopoly_regular(0, 0, 1, 2), geopoly_regular(0, 0, -1, 5);
    SELECT geopoly_json('not json'), geopoly_json('[[0,0],[1,0],[1,1]]'), geopoly_json(NULL), geopoly_area(x'0102');
}
expect {
    [[0.0,0.0],[1.0,0.0],[1.0,1.0],[0.0,1.0],[0.0,0.0]]
    4.0|-4.0
    0100000300000000000000000000803F000000000000803F0000803F
    [[0.0,0.0],[2.0,0.0],[2.0,2.0],[0.0,2.0],[0.0,0.0]]
    [[0.0,0.0],[4.0,0.0],[4.0,5.0],[0.0,5.0],[0.0,0.0]]
    <polyline points='0,0 1,0 1,1 0,0' fill="red"></polyline>
    [[1.0,1.0],[3.0,1.0],[3.0,3.0],[1.0,1.0]]
    2|1|0
    3|2|0|1
    1|2
    1||
    |||
}

test geopoly-table {
    CREATE VIRTUAL TABLE g USING geopoly(name);
    INSERT INTO g(_shape, name) VALUES('[[0,0],[4,0],[4,4],[0,4],[0,0]]', 'square');
    INSERT INTO g(_shape, name) VALUES('[[10,10],[12,10],[11,12],[10,10]]', 'triangle');
    SELECT rowid, name, geopoly_json(_shape) FROM g;
    SELECT name FROM g WHERE geopoly_overlap(_shape, '[[1,1],[2,1],[2,2],[1,2],[1,1]]');
    SELECT name FROM g WHERE geopoly_within(_shape, '[[-1,-1],[20,-1],[20,20],[-1,20],[-1,-1]]') ORDER BY name;
    SELECT geopoly_json(geopoly_group_bbox(_shape)) FROM g;
    UPDATE g SET name = 'tri' WHERE name = 'triangle';
    UPDATE g SET _shape = '[[100,100],[101,100],[101,101],[100,100]]' WHERE name = 'square';
    SELECT rowid, name, geopoly_json(_shape) FROM g;
    SELECT nodeno, hex(data) FROM g_node;
    DELETE FROM g WHERE name = 'tri';
    SELECT rowid, nodeno, hex(a0), a1 FROM g_rowid;
}
expect {
    1|square|[[0.0,0.0],[4.0,0.0],[4.0,4.0],[0.0,4.0],[0.0,0.0]]
    2|triangle|[[10.0,10.0],[12.0,10.0],[11.0,12.0],[10.0,10.0]]
    square
    square
    triangle
    [[0.0,0.0],[12.0,0.0],[12.0,12.0],[0.0,12.0],[0.0,0.0]]
    2|tri|[[10.0,10.0],[12.0,10.0],[11.0,12.0],[10.0,10.0]]
    1|square|[[100.0,100.0],[101.0,100.0],[101.0,101.0],[100.0,100.0]]
    1|
    1|1|010000030000C8420000C8420000CA420000C8420000CA420000CA42|square
}

test geopoly-bad-shape {
    CREATE VIRTUAL TABLE g USING geopoly();
    INSERT INTO g(_shape) VALUES('[[0,0],[1,0]]');
}
expect error {
    _shape does not contain a valid polygon
}
