# json_array_insert() and jsonb_array_insert() (SQLite 3.53), and the jsonb_each()
# and jsonb_tree() table-valued functions (SQLite 3.51). Expected output is
# from SQLite 3.54.1.

@database :memory:

test json-array-insert-positions {
    SELECT json_array_insert('[1,2,3]', '$[0]', 'x'),
           json_array_insert('[1,2,3]', '$[3]', 'x'),
           json_array_insert('[1,2,3]', '$[#]', 'x'),
           json_array_insert('[1,2,3]', '$[#-1]', 'x'),
           json_array_insert('[1,2,3]', '$[#-3]', 'x');
}
expect {
    ["x",1,2,3]|[1,2,3,"x"]|[1,2,3,"x"]|[1,2,"x",3]|["x",1,2,3]
}

test json-array-insert-out-of-range-is-noop {
    SELECT json_array_insert('[1,2,3]', '$[4]', 'x'),
           json_array_insert('[1,2,3]', '$[#-4]', 'x'),
           json_array_insert('[1]', '$[5].c', 9),
           json_array_insert('1', '$[0]', 9),
           json_array_insert('{"a":1}', '$.a.c', 9);
}
expect {
    [1,2,3]|[1,2,3]|[1]|1|{"a":1}
}

test json-array-insert-creates-missing-array {
    SELECT json_array_insert('{"a":1}', '$.b[0]', 9),
           json_array_insert('{"a":1}', '$.b[1]', 9),
           json_array_insert('{"a":1}', '$.b.c[0]', 9),
           json_array_insert('[1]', '$[1][0]', 9);
}
expect {
    {"a":1,"b":[9]}|{"a":1}|{"a":1,"b":{"c":[9]}}|[1,[9]]
}

test json-array-insert-nested-and-values {
    SELECT json_array_insert('[[1,2]]', '$[0][1]', json('[7]')),
           json_array_insert('[[1,2]]', '$[0][1]', '[7]'),
           json_array_insert('{"a":[1]}', '$.a[0]', json('{"x":[1]}')),
           json_array_insert('[1,2]', '$[0]', 1.5),
           json_array_insert('[1]', '$[0]', NULL);
}
expect {
    [[1,[7],2]]|[[1,"[7]",2]]|{"a":[{"x":[1]},1]}|[1.5,1,2]|[null,1]
}

test json-array-insert-multiple-pairs {
    SELECT json_array_insert('[1,2]', '$[0]', 'a', '$[0]', 'b'),
           json_array_insert('{"a":[1,2]}', '$.a[#]', 3, '$.a[0]', 0),
           json_array_insert('[1,2]', NULL, 'a'),
           json_array_insert('[1]', '$', 9),
           json_array_insert('[1,2]');
}
expect {
    ["b","a",1,2]|{"a":[0,1,2,3]}|[1,2]|[1]|[1,2]
}

test json-array-insert-null-document {
    SELECT json_array_insert(NULL, '$[0]', 1) IS NULL;
}
expect {
    1
}

test json-array-insert-object-member-errors {
    SELECT json_array_insert('{"a":1}', '$.a', 9);
}
expect error {
    not an array element: '\$\.a'
}

test json-array-insert-missing-member-errors {
    SELECT json_array_insert('{"a":1}', '$.b', 9);
}
expect error {
    not an array element: '\$\.b'
}

test json-array-insert-nested-member-errors {
    SELECT json_array_insert('[{}]', '$[0].c', 9);
}
expect error {
    not an array element: '\$\[0\]\.c'
}

test json-array-insert-path-past-end-errors {
    SELECT json_array_insert('[1]', '$[1].c', 9);
}
expect error {
    not an array element: '\$\[1\]\.c'
}

test json-array-insert-bad-path-errors {
    SELECT json_array_insert('[1,2]', '$[1', 1);
}
expect error {
    bad JSON path: '\$\[1'
}

test json-array-insert-even-args-errors {
    SELECT json_array_insert('[1,2]', '$[0]');
}
expect error {
    json_array_insert\(\) needs an odd number of arguments
}

test jsonb-array-insert {
    SELECT hex(jsonb_array_insert('[1,2]', '$[1]', 3)),
           json(jsonb_array_insert(jsonb('[1,2]'), '$[1]', 3)),
           typeof(jsonb_array_insert('[1]', '$[0]', 2));
}
expect {
    6B133113331332|[1,3,2]|blob
}

test jsonb-each-returns-jsonb-containers {
    SELECT key, hex(value), type, atom, fullkey, path
      FROM jsonb_each('{"a":[1,2],"b":{"c":3},"d":4}');
}
expect {
    a|4B13311332|array||$.a|$
    b|4C17631333|object||$.b|$
    d|34|integer|4|$.d|$
}

test jsonb-tree-returns-jsonb-containers {
    SELECT key, hex(value), type, typeof(value), fullkey
      FROM jsonb_tree('{"a":[1,{"x":2}]}');
}
expect {
    |AC17617B13314C17781332|object|blob|$
    a|7B13314C17781332|array|blob|$.a
    0|31|integer|integer|$.a[0]
    1|4C17781332|object|blob|$.a[1]
    x|32|integer|integer|$.a[1].x
}

test jsonb-each-with-root-path {
    SELECT key, hex(value), type FROM jsonb_each('[[1],"s"]', '$[0]');
}
expect {
    0|31|integer
}

test jsonb-each-of-jsonb-input {
    SELECT hex(value), json(value) FROM jsonb_each(jsonb('{"a":[1]}'));
}
expect {
    2B1331|[1]
}
