@database :temp:

# PRAGMA wal_checkpoint(NOOP) (SQLite 3.51) reports the WAL size and the
# backfilled frames without checkpointing. An unknown mode name means PASSIVE.
# Expected output is from SQLite 3.54.1.

@skip-if mvcc "MVCC checkpoints in TRUNCATE mode by default, so the frame counts differ"
test wal-checkpoint-noop-does-not-backfill {
    PRAGMA journal_mode=wal;
    CREATE TABLE t(x);
    INSERT INTO t VALUES (1);
    INSERT INTO t VALUES (2);
    PRAGMA wal_checkpoint(NOOP);
    PRAGMA wal_checkpoint=noop;
    PRAGMA wal_checkpoint(PASSIVE);
    PRAGMA wal_checkpoint(NOOP);
}
expect {
    wal
    0|4|0
    0|4|0
    0|4|4
    0|4|4
}

@skip-if mvcc "MVCC checkpoints in TRUNCATE mode by default, so the frame counts differ"
test wal-checkpoint-noop-after-wal-restart {
    PRAGMA journal_mode=wal;
    CREATE TABLE t(x);
    PRAGMA wal_checkpoint(PASSIVE);
    INSERT INTO t VALUES (1);
    PRAGMA main.wal_checkpoint(NOOP);
}
expect {
    wal
    0|2|2
    0|1|0
}

test wal-checkpoint-noop-temp-schema {
    PRAGMA temp.wal_checkpoint(NOOP);
}
expect {
    0|-1|-1
}

@skip-if mvcc "MVCC checkpoints in TRUNCATE mode by default, so the frame counts differ"
test wal-checkpoint-unknown-mode-is-passive {
    PRAGMA journal_mode=wal;
    CREATE TABLE t(x);
    PRAGMA wal_checkpoint(bogus);
}
expect {
    wal
    0|2|2
}
