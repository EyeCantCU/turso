@database :memory:
@skip-file-if mvcc "WITHOUT ROWID writes are not supported in MVCC mode"

test without-rowid-hidden-rowid {
    CREATE TABLE t(a INTEGER PRIMARY KEY, b TEXT) WITHOUT ROWID;
    SELECT rowid FROM t;
}
expect error {
    no such column: rowid
}

test without-rowid-primary-key-uniqueness {
    CREATE TABLE t(a TEXT PRIMARY KEY, b INTEGER) WITHOUT ROWID;
    INSERT INTO t VALUES ('k', 1);
    INSERT INTO t VALUES ('k', 2);
}
expect error {
    UNIQUE constraint failed
}

test without-rowid-join-does-not-use-a-hash-join {
    CREATE TABLE left_table(k1 INTEGER, k2 INTEGER, PRIMARY KEY(k2, k1)) WITHOUT ROWID;
    CREATE TABLE right_table(k1 INTEGER, k2 INTEGER, PRIMARY KEY(k2, k1)) WITHOUT ROWID;
    INSERT INTO left_table SELECT value, value % 23 FROM generate_series(1, 200);
    INSERT INTO right_table SELECT value, value % 23 FROM generate_series(1, 220);
    SELECT count(*) FROM left_table JOIN right_table ON left_table.k1 = right_table.k1;
}
expect {
    200
}

test without-rowid-missing-primary-key-rejected {
    CREATE TABLE t(a INTEGER, b TEXT) WITHOUT ROWID;
}
expect error {
    PRIMARY KEY missing on table t
}

test without-rowid-secondary-unique {
    CREATE TABLE t(a INTEGER PRIMARY KEY, b TEXT UNIQUE) WITHOUT ROWID;
    INSERT INTO t VALUES (1, 'x'), (2, 'y');
    INSERT OR IGNORE INTO t VALUES (3, 'x');
    SELECT * FROM t;
    PRAGMA integrity_check;
}
expect {
    1|x
    2|y
    ok
}

test without-rowid-secondary-unique-violation {
    CREATE TABLE t(a INTEGER PRIMARY KEY, b TEXT UNIQUE) WITHOUT ROWID;
    INSERT INTO t VALUES (1, 'x');
    INSERT INTO t VALUES (2, 'x');
}
expect error {
    UNIQUE constraint failed: t.b
}

test without-rowid-autoincrement-rejected {
    CREATE TABLE t(a INTEGER PRIMARY KEY AUTOINCREMENT, b TEXT) WITHOUT ROWID;
}
expect error {
    AUTOINCREMENT
}

test without-rowid-record-puts-primary-key-first {
    CREATE TABLE t(a TEXT, b INT, c, PRIMARY KEY(b, a)) WITHOUT ROWID;
    INSERT INTO t VALUES ('x', 1, 'c1'), ('y', 2, 'c2'), ('z', 1, 'c3');
    SELECT a, b, typeof(b), c FROM t;
}
expect {
    x|1|integer|c1
    z|1|integer|c3
    y|2|integer|c2
}

test without-rowid-create-index {
    CREATE TABLE t(a INTEGER PRIMARY KEY, b TEXT, c) WITHOUT ROWID;
    INSERT INTO t VALUES (1, 'q', 10), (2, 'p', 20), (3, 'q', 30);
    CREATE INDEX t_b ON t(b);
    SELECT name, key FROM pragma_index_xinfo('t_b');
    INSERT INTO t VALUES (4, 'p', 40);
    PRAGMA integrity_check;
}
expect {
    b|1
    a|0
    ok
}

test without-rowid-update {
    CREATE TABLE t(a INTEGER PRIMARY KEY, b TEXT UNIQUE, c) WITHOUT ROWID;
    CREATE INDEX t_c ON t(c);
    INSERT INTO t VALUES (1, 'x', 10), (2, 'y', 20), (3, 'z', 30);
    UPDATE t SET c = c + 1 WHERE b = 'y';
    UPDATE t SET a = a + 10;
    UPDATE OR IGNORE t SET b = 'x' WHERE a = 12;
    SELECT * FROM t;
    PRAGMA integrity_check;
}
expect {
    11|x|10
    12|y|21
    13|z|30
    ok
}

test without-rowid-update-key-conflict {
    CREATE TABLE t(a INTEGER PRIMARY KEY, b) WITHOUT ROWID;
    INSERT INTO t VALUES (1, 'x'), (2, 'y');
    UPDATE t SET a = 2 WHERE a = 1;
}
expect error {
    UNIQUE constraint failed: t.a
}

test without-rowid-update-or-replace-key {
    CREATE TABLE t(a INTEGER PRIMARY KEY, b) WITHOUT ROWID;
    INSERT INTO t VALUES (1, 'x'), (2, 'y');
    UPDATE OR REPLACE t SET a = 2 WHERE a = 1;
    SELECT * FROM t;
}
expect {
    2|x
}

test without-rowid-delete {
    CREATE TABLE t(a INTEGER PRIMARY KEY, b TEXT) WITHOUT ROWID;
    CREATE INDEX t_b ON t(b);
    INSERT INTO t VALUES (1, 'x'), (2, 'y'), (3, 'x');
    DELETE FROM t WHERE b = 'x';
    SELECT * FROM t;
    SELECT changes();
    PRAGMA integrity_check;
}
expect {
    2|y
    2
    ok
}

test without-rowid-delete-with-trigger {
    CREATE TABLE t(a INTEGER PRIMARY KEY, b TEXT) WITHOUT ROWID;
    CREATE TABLE log(x);
    CREATE TRIGGER t_d AFTER DELETE ON t BEGIN INSERT INTO log VALUES (old.a || old.b); END;
    INSERT INTO t VALUES (1, 'x'), (2, 'y'), (3, 'x');
    DELETE FROM t WHERE b = 'x';
    SELECT * FROM log;
}
expect {
    1x
    3x
}

test without-rowid-insert-or-replace {
    CREATE TABLE t(a INTEGER PRIMARY KEY, b TEXT UNIQUE) WITHOUT ROWID;
    INSERT INTO t VALUES (1, 'x'), (2, 'y');
    INSERT OR REPLACE INTO t VALUES (1, 'y');
    SELECT * FROM t;
    PRAGMA integrity_check;
}
expect {
    1|y
    ok
}

test without-rowid-upsert {
    CREATE TABLE t(k TEXT, n INT, v, PRIMARY KEY(k, n)) WITHOUT ROWID;
    INSERT INTO t VALUES ('a', 1, 0);
    INSERT INTO t VALUES ('a', 1, 5) ON CONFLICT(n, k) DO UPDATE SET v = v + excluded.v;
    INSERT INTO t VALUES ('a', 1, 5) ON CONFLICT(k, n) DO UPDATE SET v = v + excluded.v;
    INSERT INTO t VALUES ('a', 1, 5) ON CONFLICT DO NOTHING;
    SELECT * FROM t;
}
expect {
    a|1|10
}

test without-rowid-foreign-keys {
    PRAGMA foreign_keys = ON;
    CREATE TABLE p(a, b, PRIMARY KEY(a, b)) WITHOUT ROWID;
    CREATE TABLE c(x, y, FOREIGN KEY(x, y) REFERENCES p ON DELETE CASCADE) ;
    INSERT INTO p VALUES (1, 2), (3, 4);
    INSERT INTO c VALUES (1, 2), (3, 4);
    DELETE FROM p WHERE a = 1;
    SELECT * FROM c;
}
expect {
    3|4
}

test without-rowid-foreign-key-violation {
    PRAGMA foreign_keys = ON;
    CREATE TABLE p(a PRIMARY KEY) WITHOUT ROWID;
    CREATE TABLE c(x REFERENCES p);
    INSERT INTO c VALUES (1);
}
expect error {
    FOREIGN KEY constraint failed
}

test without-rowid-redundant-unique-has-no-index {
    CREATE TABLE t(a, b UNIQUE PRIMARY KEY) WITHOUT ROWID;
    CREATE TABLE u(a UNIQUE, b, PRIMARY KEY(b)) WITHOUT ROWID;
    SELECT name FROM sqlite_schema ORDER BY name;
}
expect {
    sqlite_autoindex_u_1
    t
    u
}

test without-rowid-analyze {
    CREATE TABLE m(a, b, c, PRIMARY KEY(a, b)) WITHOUT ROWID;
    CREATE INDEX m_c ON m(c);
    INSERT INTO m VALUES (1, 1, 1), (1, 2, 1), (2, 1, 3);
    ANALYZE;
    SELECT * FROM sqlite_stat1 ORDER BY idx;
}
expect {
    m|m|3 2 1
    m|m_c|3 2
}

test without-rowid-drop-column {
    CREATE TABLE t(k TEXT PRIMARY KEY, v, x, y) WITHOUT ROWID;
    INSERT INTO t VALUES ('a', 1, 0, 9), ('b', 2, 0, 8);
    ALTER TABLE t DROP COLUMN x;
    SELECT * FROM t;
}
expect {
    a|1|9
    b|2|8
}

test without-rowid-add-column-check-reads-columns-in-declared-order {
    CREATE TABLE t(c, d, a, PRIMARY KEY(a, d)) WITHOUT ROWID;
    INSERT INTO t VALUES (1, 2, 3);
    ALTER TABLE t ADD COLUMN b INT DEFAULT 4 CHECK (c = 1 AND d = 2 AND a = 3 AND b = 4);
    SELECT * FROM t;
}
expect {
    1|2|3|4
}

@skip-if sqlite "SQLite does not name the failing CHECK of ADD COLUMN"
test without-rowid-add-column-check-rejects-primary-key-value {
    CREATE TABLE t(c, a PRIMARY KEY) WITHOUT ROWID;
    INSERT INTO t VALUES (5, 2);
    ALTER TABLE t ADD COLUMN b INT CHECK (a = 5);
}
expect error {
    CHECK constraint failed: a = 5
}

test without-rowid-secondary-index-lookup {
    CREATE TABLE u(k TEXT PRIMARY KEY, v UNIQUE, w, x) WITHOUT ROWID;
    CREATE INDEX uw ON u(w);
    INSERT INTO u VALUES ('a', 1, 'p', 10), ('b', 2, 'q', 20), ('c', 3, 'p', 30);
    SELECT k, x FROM u WHERE w = 'p' ORDER BY k;
    SELECT x FROM u WHERE v = 3;
    SELECT k, x FROM u INDEXED BY uw WHERE w = 'q';
}
expect {
    a|10
    c|30
    30
    b|20
}

test without-rowid-indexed-by-in-writes {
    CREATE TABLE u(k TEXT PRIMARY KEY, w, x) WITHOUT ROWID;
    CREATE INDEX uw ON u(w);
    INSERT INTO u VALUES ('a', 'p', 1), ('b', 'q', 2);
    UPDATE u INDEXED BY uw SET x = x + 1 WHERE w = 'p';
    DELETE FROM u INDEXED BY uw WHERE w = 'q';
    SELECT * FROM u;
}
expect {
    a|p|2
}

test without-rowid-eqp-index {
    CREATE TABLE u(k TEXT PRIMARY KEY, v UNIQUE, w, x) WITHOUT ROWID;
    CREATE INDEX uw ON u(w);
    EXPLAIN QUERY PLAN SELECT k, x FROM u WHERE w = 'p';
}
expect pattern {
    SEARCH u USING INDEX uw \(w=\?\)
}

test without-rowid-eqp-covering-index {
    CREATE TABLE u(k TEXT PRIMARY KEY, v UNIQUE, w, x) WITHOUT ROWID;
    CREATE INDEX uw ON u(w);
    EXPLAIN QUERY PLAN SELECT k FROM u WHERE w = 'p';
}
expect pattern {
    SEARCH u USING COVERING INDEX uw \(w=\?\)
}

test without-rowid-eqp-primary-key {
    CREATE TABLE u(k TEXT PRIMARY KEY, v UNIQUE, w, x) WITHOUT ROWID;
    CREATE INDEX uw ON u(w);
    EXPLAIN QUERY PLAN SELECT x FROM u WHERE k = 'a';
}
expect pattern {
    SEARCH u USING PRIMARY KEY \(k=\?\)
}

test without-rowid-multi-index-or {
    CREATE TABLE u(k TEXT PRIMARY KEY, v, w, x) WITHOUT ROWID;
    CREATE INDEX uv ON u(v);
    CREATE INDEX uw ON u(w);
    INSERT INTO u SELECT 'k' || value, value % 17, value % 23, value FROM generate_series(1, 300);
    ANALYZE;
    SELECT count(*), sum(x) FROM u WHERE v = 3 OR w = 5;
    SELECT x FROM u WHERE k IN ('k5', 'k7', 'k300') ORDER BY x;
}
expect {
    30|4256
    5
    7
    300
}

test without-rowid-update-delete-through-index {
    CREATE TABLE u(k TEXT PRIMARY KEY, v UNIQUE, w, x) WITHOUT ROWID;
    CREATE INDEX uw ON u(w);
    INSERT INTO u SELECT 'k' || value, value, value % 13, value % 7 FROM generate_series(1, 200);
    ANALYZE;
    UPDATE u SET x = x + 100 WHERE w = 3;
    UPDATE u SET w = w + 1 WHERE w = 5;
    UPDATE u SET k = k || 'z' WHERE w = 7;
    DELETE FROM u WHERE w = 1;
    SELECT count(*), sum(x), sum(w) FROM u;
    PRAGMA integrity_check;
}
expect {
    184|2155|1185
    ok
}

test without-rowid-eqp-delete-through-index {
    CREATE TABLE u(k TEXT PRIMARY KEY, w, x) WITHOUT ROWID;
    CREATE INDEX uw ON u(w);
    EXPLAIN QUERY PLAN DELETE FROM u WHERE w = 1;
}
expect pattern {
    SEARCH u USING INDEX uw \(w=\?\)
}
